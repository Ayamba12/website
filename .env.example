FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
AI_AGENT_API_KEY=
PORT=5000
# Your deployed frontend's origin — used to build sitemap.xml URLs (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Object storage for opportunity images/logos (S3-compatible — Neon Object Storage,
# AWS S3, Cloudflare R2, Backblaze B2, etc. all work). Bucket should be public-read
# so uploaded image URLs are viewable without credentials.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
STORAGE_BUCKET=
